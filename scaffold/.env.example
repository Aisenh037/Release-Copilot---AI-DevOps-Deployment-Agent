# Copy to scaffold/.env and fill in real values.

# Gemini (used by the Next.js app and demo.mts via the Vercel AI SDK)
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Provider credentials, consumed by the Samvaya execution kernel. Each var is
# referenced by name in a provider definition (src/lib/platform/connectors/*) and
# resolved at call time by the env auth resolver (src/lib/platform/auth.ts).
# GitHub/Netlify/Notion: bearer tokens. Jira: basic auth (email + API token)
# against the JIRA_SITE base URL.
GITHUB_API_KEY=
JIRA_API_KEY=
JIRA_EMAIL=
JIRA_SITE=
NETLIFY_API_KEY=
NOTION_API_KEY=

# Demo constants (interpolated into the system prompt / used as tool args)
RELEASE_REPO=
RELEASE_BRANCH=
JIRA_PROJECT_KEY=
NETLIFY_SITE_ID=
NOTION_PARENT_PAGE_ID=
NEXT_PUBLIC_JIRA_SITE=

# Platform debugging (optional)
# PLATFORM_DRY_RUN=1 previews every provider request without touching the network.
# AUDIT_LOG_FILE appends one JSON audit line per execution attempt to this path.
PLATFORM_DRY_RUN=
AUDIT_LOG_FILE=
